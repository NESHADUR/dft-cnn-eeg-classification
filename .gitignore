# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.conda/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ---- Office lock / temp files (Word masters) ----
~$*
*.tmp
*.bak

# ---- ML artefacts (keep the committed checkpoints, ignore new runs) ----
runs/
logs/
*.log
*.h5
*.onnx
checkpoints/
# NOTE: model_dft_cnn.pth and model_raw_cnn.pth are intentionally committed.
# *.pth is NOT ignored here for that reason.

# ---- LaTeX build products ----
*.aux
*.toc
*.out
*.synctex.gz

# ---- Large / generated data (dataset CSV is intentionally committed) ----
*.zip
*.tar.gz
